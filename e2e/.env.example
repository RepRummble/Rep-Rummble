# Copy to .env for local overrides. Playwright auto-loads it via dotenv in playwright.config.ts.

# Leave BASE_URL/API_BASE_URL unset to run against a local dev stack that
# Playwright starts automatically (web on :5173, server on :5001).
# Set both to point Playwright at a real deployment instead (e.g. staging).
# NEVER point these at production — several tests intentionally send bad
# input, hammer the login endpoint to verify rate limiting, and create
# throwaway test accounts.
#BASE_URL=https://staging.reprummble.com
#API_BASE_URL=https://staging-api.reprummble.com

# Used by tests that need a *second* distinct, already-existing account to
# verify one user cannot read/modify another user's data (IDOR checks).
# Leave unset and those specific tests will be skipped with a clear reason
# instead of failing.
#TEST_USER_A_EMAIL=
#TEST_USER_A_PASSWORD=
#TEST_USER_B_EMAIL=
#TEST_USER_B_PASSWORD=
