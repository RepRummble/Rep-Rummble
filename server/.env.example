# Copy this file to .env and fill in real values. NEVER commit .env: it holds secrets.
# Every value below is a placeholder.

PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/reprummble
JWT_SECRET=
JWT_EXPIRE=7d
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=
USDA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
ADMIN_EMAILS=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Connected devices (see docs/DEVICES.md). Leave blank to keep a device switched off.
# Generate DEVICE_TOKEN_KEY with: openssl rand -base64 32   (locks the sign-ins we store; losing it means everyone signs in again)
DEVICE_TOKEN_KEY=
PUBLIC_API_URL=https://YOUR-API-HOST
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
